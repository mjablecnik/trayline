#!/usr/bin/env bash
set -euo pipefail

IMAGE_NAME="kiro-sandbox"
PROXY_NAME="kiro-docker-proxy"
NETWORK_NAME="kiro-net"

usage() {
  cat <<EOF
Usage: kiro-docker [-i] [project-dir] <prompt>
       kiro-docker -i [project-dir]

Run Kiro CLI in a sandboxed Docker container with access to host Docker.

Options:
  -i           Start in interactive mode (no prompt required)
  -h, --help   Show this help

Arguments:
  project-dir  Path to project directory (default: current directory)
  prompt       Query for Kiro (required unless -i is used)

Examples:
  kiro-docker "Show me running containers"                 # one-shot, cwd
  kiro-docker ~/my-project "Add a /health endpoint"        # one-shot, project dir
  kiro-docker -i                                           # interactive, cwd
  kiro-docker -i ~/my-project                              # interactive, project dir
EOF
  exit 0
}

INTERACTIVE=false
while [[ "${1:-}" == -* ]]; do
  case "$1" in
    -i) INTERACTIVE=true; shift ;;
    -h|--help) usage ;;
    *) echo "Unknown option: $1" >&2; usage ;;
  esac
done

# Parse optional project dir
if [[ -n "${1:-}" ]] && [[ -d "$1" ]]; then
  PROJECT_DIR="$(cd "$1" && pwd)"
  shift
else
  PROJECT_DIR="$(pwd)"
fi

PROMPT="$*"

if ! $INTERACTIVE && [[ -z "$PROMPT" ]]; then
  usage
fi

# Build if image doesn't exist
if ! docker image inspect "$IMAGE_NAME" &>/dev/null; then
  echo "Building $IMAGE_NAME image (first run, may take a while)..."
  docker build -t "$IMAGE_NAME" "$(dirname "$0")"
fi

# Create network if needed
docker network inspect "$NETWORK_NAME" &>/dev/null || \
  docker network create "$NETWORK_NAME"

# Start docker socket proxy if not running
if ! docker inspect "$PROXY_NAME" &>/dev/null; then
  docker run -d --name "$PROXY_NAME" \
    --network "$NETWORK_NAME" \
    --restart unless-stopped \
    -v /var/run/docker.sock:/var/run/docker.sock:ro \
    -e CONTAINERS=1 \
    -e IMAGES=1 \
    -e NETWORKS=1 \
    -e LOGS=1 \
    -e BUILD=1 \
    -e POST=1 \
    -e EXEC=1 \
    -e ALLOW_START=1 \
    -e ALLOW_STOP=1 \
    -e ALLOW_RESTARTS=1 \
    -e VOLUMES=0 \
    -e NODES=0 \
    -e SERVICES=0 \
    -e SWARM=0 \
    -e SECRETS=0 \
    -e CONFIGS=0 \
    -e AUTH=0 \
    tecnativa/docker-socket-proxy
fi

KIRO_ARGS=(chat --trust-all-tools)
if ! $INTERACTIVE; then
  KIRO_ARGS+=(--no-interactive "$PROMPT")
fi

# Run Kiro sandbox connected to proxy
docker run --rm -it \
  --network "$NETWORK_NAME" \
  -e DOCKER_HOST="tcp://${PROXY_NAME}:2375" \
  -v "$PROJECT_DIR":/workspace \
  -v "/mnt/c/Users/marti/.kiro":/root/.kiro \
  -v "${HOME}/.local/share/kiro-cli":/root/.local/share/kiro-cli \
  "$IMAGE_NAME" \
  "${KIRO_ARGS[@]}"
