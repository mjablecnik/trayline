#compdef trayline-client

_trayline_client() {
    local state

    _arguments -C \
        '--server[Trayline server URL]:URL:' \
        '--token[Bearer authentication token]:TOKEN:' \
        '--quiet[Suppress informational messages on stderr]' \
        '--verbose[Print HTTP method, URL, status, and timing on stderr]' \
        '--help[Show help message and exit]' \
        '-h[Show help message and exit]' \
        '--version[Show version information and exit]' \
        '-v[Show version information and exit]' \
        '1:subcommand:->subcommand' \
        '*::args:->args' \
        && return 0

    case "${state}" in
        subcommand)
            local subcommands
            subcommands=(
                'health:Check server connectivity'
                'chat:Start or reconnect to an interactive chat session'
                'run:Execute a one-shot task and wait for the result'
                'tasks:List all tasks'
                'task:Show task details'
                'cancel:Cancel a running task'
                'sessions:List active sessions'
                'terminate:Terminate a session'
                'schedule:Schedule and manage pipeline workflows'
            )
            _describe 'subcommand' subcommands
            ;;
        args)
            case "${words[1]}" in
                chat)
                    _arguments \
                        '--agent[Agent to use (kiro or claude)]:AGENT:(kiro claude)' \
                        '--model[Model override]:MODEL:' \
                        '--system[System prompt override]:PROMPT:' \
                        '--session[Reconnect to an existing session ID]:ID:' \
                        '--help[Show help for this subcommand]' \
                        '-h[Show help for this subcommand]'
                    ;;
                run)
                    _arguments \
                        '--agent[Agent to use (kiro or claude)]:AGENT:(kiro claude)' \
                        '--prompt[Prompt text to send]:TEXT:' \
                        '--model[Model override]:MODEL:' \
                        '--system[System prompt override]:PROMPT:' \
                        '--format[Output format]:FORMAT:(json text markdown)' \
                        '*--file[Upload a file alongside the prompt (repeatable)]:FILE:_files' \
                        '--help[Show help for this subcommand]' \
                        '-h[Show help for this subcommand]'
                    ;;
                task|cancel)
                    _arguments \
                        '--help[Show help for this subcommand]' \
                        '-h[Show help for this subcommand]' \
                        '1:task ID:'
                    ;;
                terminate)
                    _arguments \
                        '--help[Show help for this subcommand]' \
                        '-h[Show help for this subcommand]' \
                        '1:session ID:'
                    ;;
                health|tasks|sessions)
                    _arguments \
                        '--help[Show help for this subcommand]' \
                        '-h[Show help for this subcommand]'
                    ;;
                schedule)
                    _trayline_client_schedule
                    ;;
            esac
            ;;
    esac
}

_trayline_client_schedule() {
    local state

    _arguments -C \
        '--project[Project name]:NAME:' \
        '--help[Show help for this subcommand]' \
        '-h[Show help for this subcommand]' \
        '1:action:->action' \
        '*::args:->schedule_args' \
        && return 0

    case "${state}" in
        action)
            local actions
            actions=(
                'list:List all workflows for the project'
                'show:Show details of a specific workflow'
                'cancel:Cancel a queued or running workflow'
                'delete:Delete a queued or failed workflow'
                'retry:Retry a failed workflow'
                'logs:Stream logs for a workflow'
                'tasks/:Task pipelines'
                'processes/:Process pipelines'
                'workflows/:Workflow pipelines'
            )
            _describe 'action or pipeline' actions
            ;;
        schedule_args)
            case "${words[1]}" in
                list)
                    _arguments \
                        '--project[Project name]:NAME:' \
                        '--help[Show help]' \
                        '-h[Show help]'
                    ;;
                show|cancel|delete|retry)
                    _arguments \
                        '--project[Project name]:NAME:' \
                        '--help[Show help]' \
                        '-h[Show help]' \
                        '1:workflow ID:'
                    ;;
                logs)
                    _arguments \
                        '--project[Project name]:NAME:' \
                        '--help[Show help]' \
                        '-h[Show help]' \
                        '1:workflow ID (optional):'
                    ;;
                tasks/*)
                    _arguments \
                        '--project[Project name]:NAME:' \
                        '*--var[Pipeline variable (key=value)]:VAR:' \
                        '--help[Show help]' \
                        '-h[Show help]'
                    ;;
                processes/*)
                    _arguments \
                        '--project[Project name]:NAME:' \
                        '*--var[Pipeline variable (key=value)]:VAR:' \
                        '--help[Show help]' \
                        '-h[Show help]'
                    ;;
                workflows/*)
                    _arguments \
                        '--project[Project name]:NAME:' \
                        '*--var[Pipeline variable (key=value)]:VAR:' \
                        '--help[Show help]' \
                        '-h[Show help]'
                    ;;
                *)
                    # Completing pipeline names or flags for schedule add
                    _arguments \
                        '--project[Project name]:NAME:' \
                        '*--var[Pipeline variable (key=value)]:VAR:' \
                        '--help[Show help]' \
                        '-h[Show help]'
                    ;;
            esac
            ;;
    esac
}

_trayline_client "$@"
