# Required: Bearer token for API authentication
API_TOKEN=your-secret-token-here

# Required: Host filesystem path to workspace directory (used for Docker volume mounts)
WORKSPACE_HOST_DIR=/path/to/workspace

# Required: Directory scanned for dashboard projects (must contain git repos as subdirectories)
PROJECTS_DIR=/path/to/projects

# Optional: Directory containing bare git repos used as remotes by projects.
# Mounted into workflow containers so lifecycle git pull/push works.
# Default: ~/repos (auto-detected if exists)
# REPOS_DIR=/home/martin/repos

# Docker proxy endpoint — used by the server to reach the Docker daemon via trayline-proxy.
# Set automatically by start-docker.sh. Override only if your proxy name or port differs.
# DOCKER_HOST=tcp://trayline-proxy:2375

# Server port (default: 8080)
APP_PORT=8080

# Maximum concurrent one-shot task containers (/run endpoint, pipelines), 1-32 (default: 2)
MAX_CONCURRENT_TASKS=2

# Maximum concurrent interactive chat sessions (dashboard, CLI chat), 1-32 (default: 4)
# Reserved separately from MAX_CONCURRENT_TASKS so a busy task pipeline can never
# starve out interactive chat sessions of capacity.
MAX_CHAT_SESSIONS=4

# Workspace directory inside the server container (default: ./workspace)
WORKSPACE_DIR=/workspace

# Chat session idle timeout (default: 24h)
SESSION_TIMEOUT=24h

# One-shot task max execution time (default: 10m)
TASK_TIMEOUT=10m

# Requests per minute per IP (default: 60)
RATE_LIMIT=60

# Directory for persisting server state (default: /tmp/trayline-server)
STATE_DIR=/tmp/trayline-server

# Maximum file size per upload in bytes (default: 52428800 = 50 MB)
# MAX_UPLOAD_SIZE=52428800

# Maximum number of files per upload request (default: 10)
# MAX_UPLOAD_FILES=10

# Maximum prompt length in characters for /run endpoint (default: 32000)
# MAX_PROMPT_LENGTH=32000

# Allowed CORS origin for the dashboard frontend (optional; empty disables CORS)
# DASHBOARD_ORIGIN=http://localhost:5173

# --- Agent credential mounts ---
# Mirrors what trayline-agent does for CLI invocations.
# All are optional; omit any variable to skip that mount.

# Kiro: host path to ~/.kiro (workspace config, steering files)
# KIRO_HOST_DIR=/home/youruser/.kiro

# Kiro: host path to ~/.local/share/kiro-cli (auth token)
# KIRO_CREDS_HOST_DIR=/home/youruser/.local/share/kiro-cli

# Claude: host path to ~/.claude (session data)
# CLAUDE_HOST_DIR=/home/youruser/.claude

# Claude: host path to ~/.claude.json (global config / token)
# CLAUDE_CONFIG_HOST_FILE=/home/youruser/.claude.json

# --- Workflow runner (dashboard "Workflows" tab) ---

# Host path to ~/.trayline, mounted read-only into workflow containers at
# /home/agent/.trayline (default: ~/.trayline, expanded from the running user's home directory)
# TRAYLINE_HOME_DIR=/home/youruser/.trayline

# Host path to the pipelines directory used by pipeline discovery and workflow
# execution (default: TRAYLINE_HOME_DIR/pipelines)
# PIPELINES_DIR=/home/youruser/.trayline/pipelines

# --- Personal assistant agent ---

# Host directory mounted as /workspace in personal assistant containers
# (default: {parent directory of PROJECTS_DIR}/.assistant)
# ASSISTANT_DATA_DIR=/path/to/.assistant

# --- OpenAI-compatible API (/v1/...) ---

# Model mappings exposed via the OpenAI-compatible API.
# Format: public_name:agent:model_variant (comma-separated)
# Empty model_variant means use the agent's default model.
# Default: kiro:kiro:,claude:claude:,claude-sonnet:claude:sonnet
# OPENAI_MODELS=kiro:kiro:,claude:claude:,claude-sonnet:claude:sonnet
