#compdef trayline

# Zsh completion for trayline CLI

_trayline_pipelines() {
  local pipelines_dir="${TRAYLINE_HOME:-${HOME}/.trayline}/pipelines"
  if [[ ! -d "$pipelines_dir" ]]; then
    return
  fi

  local input="${words[CURRENT]}"

  # If input already contains a slash (e.g. "processes/"), show files inside that dir
  if [[ "$input" == */* ]]; then
    local subdir="${input%%/*}"
    local dir_path="${pipelines_dir}/${subdir}"
    if [[ -d "$dir_path" ]]; then
      local -a files
      files=( ${dir_path}/*.yaml(N:t:r) )
      local prefix="${subdir}/"
      compadd -P "$prefix" -S '' -- "${files[@]}"
    fi
  else
    # Show directories first
    local -a dirs
    dirs=( ${pipelines_dir}/*(N/:t) )
    _describe 'category' dirs -S '/'
  fi
}

_trayline_pipeline_vars() {
  local pipelines_dir="${TRAYLINE_HOME:-${HOME}/.trayline}/pipelines"
  local pipeline_ref=""

  # Find the pipeline reference for the CURRENT segment.
  # In flow mode, segments are separated by --then. We need the pipeline
  # from the segment where the cursor currently is (not the first one).
  local i
  local segment_pipeline=""
  for (( i=1; i <= ${#words[@]}; i++ )); do
    case "${words[$i]}" in
      --then)
        # New segment starts — reset the pipeline reference
        segment_pipeline=""
        ;;
      --var|--pipeline)
        # Skip the flag and its value
        (( i++ ))
        ;;
      --*) ;;
      run|flow|schedule) ;;
      *)
        # Non-flag argument = pipeline reference for this segment
        if [[ -z "$segment_pipeline" ]]; then
          segment_pipeline="${words[$i]}"
        fi
        ;;
    esac
  done
  pipeline_ref="$segment_pipeline"

  [[ -z "$pipeline_ref" ]] && return

  # Resolve pipeline path
  local pipeline_path=""
  if [[ "$pipeline_ref" == *.yaml || "$pipeline_ref" == *.yml ]]; then
    pipeline_path="$pipeline_ref"
  elif [[ -f "${pipelines_dir}/${pipeline_ref}.yaml" ]]; then
    pipeline_path="${pipelines_dir}/${pipeline_ref}.yaml"
  fi

  [[ -z "$pipeline_path" || ! -f "$pipeline_path" ]] && return

  # Check if user is completing a value (after =) for specs-name
  local current="${words[CURRENT]}"
  if [[ "$current" == specs-name=* ]]; then
    local typed="${current#specs-name=}"
    local specs_dir=".kiro/specs"
    if [[ -d "$specs_dir" ]]; then
      local -a specs
      specs=( ${specs_dir}/*(N/:t) )
      compadd -p "specs-name=" -S '' -- "${specs[@]}"
    fi
    return
  fi

  # Complete brief= with files (markdown and text files in project root and subdirs)
  if [[ "$current" == brief=* ]]; then
    local typed="${current#brief=}"
    local search_dir="."
    local file_prefix=""

    if [[ -n "$typed" ]]; then
      if [[ "$typed" == */ && -d "${typed%/}" ]]; then
        # Typed ends with / and is a valid directory
        search_dir="${typed%/}"
        file_prefix="$typed"
      elif [[ -d "$typed" ]]; then
        # Typed is a valid directory without trailing /
        search_dir="$typed"
        file_prefix="${typed%/}/"
      elif [[ "$typed" == */* && -d "${typed%/*}" ]]; then
        # Partial filename inside a subdirectory
        search_dir="${typed%/*}"
        file_prefix="${typed%/*}/"
      fi
      # else: partial filename at root — search_dir stays ".", file_prefix stays ""
    fi

    local -a files
    files=( ${search_dir}/*.(md|txt|yaml|yml)(N:t) )
    local -a dirs
    dirs=( ${search_dir}/*(N/:t) )

    # Use -p to set prefix that zsh won't use for matching, and let compadd filter
    local full_prefix="brief=${file_prefix}"
    [[ ${#files[@]} -gt 0 ]] && compadd -p "$full_prefix" -S '' -- "${files[@]}"
    [[ ${#dirs[@]} -gt 0 ]] && compadd -p "$full_prefix" -S '/' -- "${dirs[@]}"
    return
  fi

  # Complete path= with directories (supports nested: path=frontend/src/<TAB>)
  if [[ "$current" == path=* ]]; then
    local typed="${current#path=}"
    local search_dir="."
    local file_prefix=""

    if [[ -n "$typed" ]]; then
      if [[ "$typed" == */ && -d "${typed%/}" ]]; then
        search_dir="${typed%/}"
        file_prefix="$typed"
      elif [[ -d "$typed" ]]; then
        search_dir="$typed"
        file_prefix="${typed%/}/"
      elif [[ "$typed" == */* && -d "${typed%/*}" ]]; then
        search_dir="${typed%/*}"
        file_prefix="${typed%/*}/"
      fi
    fi

    local -a dirs
    dirs=( ${search_dir}/*(N/:t) )
    if [[ ${#dirs[@]} -gt 0 ]]; then
      compadd -p "path=${file_prefix}" -S '/' -- "${dirs[@]}"
    fi
    return
  fi

  # Extract variable keys from the variables: section
  local -a var_keys
  var_keys=( $(sed -n '/^variables:/,/^[^ ]/{ /^  [a-z]/s/^  \([a-z][a-z0-9-]*\):.*/\1=/p }' "$pipeline_path") )

  [[ ${#var_keys[@]} -eq 0 ]] && return

  _describe 'variable' var_keys -S ''
}

_trayline_agent() {
  local -a agents
  agents=(
    'kiro:Run Kiro CLI agent'
    'claude:Run Claude Code agent'
  )

  case $CURRENT in
    2)
      _describe 'agent' agents
      ;;
    *)
      _arguments \
        '-p[Project directory]:directory:_directories' \
        '-m[Model to use]:model:' \
        '-i[Interactive mode]' \
        '-h[Show help]' \
        '*:prompt:'
      ;;
  esac
}

_trayline_sync() {
  local -a actions
  actions=(
    'push:Send local changes to remote (git or rsync)'
    'pull:Fetch remote changes to local (git or rsync)'
    'setup:Initialize bare + working repo on agent machine'
  )

  case $CURRENT in
    2)
      _describe 'action' actions
      ;;
    *)
      _arguments \
        '--rsync[Use rsync instead of git]' \
        '--full[(pull --rsync) Pull everything including .kiro/]' \
        '--specs-only[(push --rsync) Push only .kiro/ directory]' \
        '--agents-only[(pull --rsync) Pull only .agents/ directory]' \
        '--code-only[(pull --rsync) Pull only code]' \
        '--dry-run[Show what would happen without doing it]' \
        '(-v --verbose)'{-v,--verbose}'[Show detailed output]' \
        '(-h --help)'{-h,--help}'[Show help]'
      ;;
  esac
}

_trayline_run() {
  _arguments \
    '1:pipeline:_trayline_pipelines' \
    '--dry-run[Print steps without executing]' \
    '--verbose[Stream output in real time]' \
    '--log-llm[Log LLM requests and responses to llm-debug.log]' \
    '--no-lifecycle[Skip lifecycle.yaml before/after steps]' \
    '--restart[Ignore checkpoint and start from the beginning]' \
    '*--var[Set variable key=value]:variable:_trayline_pipeline_vars'
}

_trayline_flow() {
  # Flow supports multiple pipelines separated by --then
  # Complete pipelines, --var, --then, and global flags
  local current="${words[CURRENT]}"
  local prev="${words[CURRENT-1]}"

  if [[ "$prev" == "--var" ]]; then
    _trayline_pipeline_vars
    return
  fi

  if [[ "$prev" == "--then" || $CURRENT -eq 2 ]]; then
    _trayline_pipelines
    return
  fi

  local -a opts
  opts=(
    '--then:Separate pipeline segments'
    '--var:Set variable key=value'
    '--dry-run:Print steps without executing'
    '--verbose:Stream output in real time'
    '--log-llm:Log LLM requests and responses'
    '--no-lifecycle:Skip lifecycle.yaml before/after steps'
    '--restart:Ignore checkpoint and start from the beginning'
  )
  _describe 'option' opts
}

_trayline_schedule() {
  local current="${words[CURRENT]}"
  local prev="${words[CURRENT-1]}"

  if (( CURRENT == 2 )); then
    # First argument after "schedule": sub-action or pipeline name
    local -a actions
    actions=(
      'list:List queued/running tasks for the project'
      'status:Show queue status for the project'
      'logs:Stream logs for the project in real time'
      'retry:Retry the failed task'
      'stop:Stop the running task'
      'cancel:Cancel a task (stop if running, else delete)'
      'delete:Delete a queued task'
    )
    _describe 'action or pipeline' actions
    _trayline_pipelines
    return
  fi

  # Determine which sub-action was chosen
  local sub="${words[2]}"
  case "$sub" in
    list|status|logs|retry|stop)
      _arguments \
        '--project[Project name]:NAME:' \
        '--help[Show help]' \
        '-h[Show help]'
      ;;
    cancel|delete)
      _arguments \
        '--project[Project name]:NAME:' \
        '--help[Show help]' \
        '-h[Show help]' \
        '1:task ID:'
      ;;
    *)
      # Scheduling a pipeline — complete --var and --project flags
      if [[ "$prev" == "--var" ]]; then
        _trayline_pipeline_vars
        return
      fi
      _arguments \
        '1:pipeline:_trayline_pipelines' \
        '--project[Project name]:NAME:' \
        '*--var[Pipeline variable (key=value)]:variable:_trayline_pipeline_vars' \
        '--help[Show help]' \
        '-h[Show help]'
      ;;
  esac
}

_trayline() {
  local -a commands
  commands=(
    'agent:Run an AI agent in Docker sandbox'
    'sync:Sync project with remote server'
    'run:Run a single pipeline (orchestrator)'
    'flow:Run multiple pipelines sequentially'
    'schedule:Schedule pipelines via the local taskline queue'
    'stop:Signal running pipeline to stop gracefully after current step'
    'install:Re-run installation'
    'version:Print version info'
    'help:Show help'
  )

  if (( CURRENT == 2 )); then
    _describe 'command' commands
  else
    local cmd="${words[2]}"
    (( CURRENT-- ))
    shift words

    case "$cmd" in
      agent) _trayline_agent ;;
      sync)  _trayline_sync ;;
      run)   _trayline_run ;;
      flow)  _trayline_flow ;;
      schedule) _trayline_schedule ;;
      stop)  _message 'no arguments' ;;
      *)     _message 'no more arguments' ;;
    esac
  fi
}

_trayline "$@"
