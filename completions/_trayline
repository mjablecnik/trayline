#compdef trayline

# Zsh completion for trayline CLI

_trayline_pipelines() {
  local pipelines_dir="${TRAYLINE_HOME:-${HOME}/.trayline}/pipelines"
  if [[ ! -d "$pipelines_dir" ]]; then
    return
  fi

  local input="${words[CURRENT]}"

  # If input already contains a slash (e.g. "processes/"), show files inside that dir
  if [[ "$input" == */* ]]; then
    local subdir="${input%%/*}"
    local dir_path="${pipelines_dir}/${subdir}"
    if [[ -d "$dir_path" ]]; then
      local -a files
      files=( ${dir_path}/*.yaml(N:t:r) )
      local prefix="${subdir}/"
      compadd -P "$prefix" -S '' -- "${files[@]}"
    fi
  else
    # Show directories first
    local -a dirs
    dirs=( ${pipelines_dir}/*(N/:t) )
    _describe 'category' dirs -S '/'
  fi
}

_trayline_pipeline_vars() {
  local pipelines_dir="${TRAYLINE_HOME:-${HOME}/.trayline}/pipelines"
  local pipeline_ref=""

  # Find the pipeline reference from the command line
  local i
  for (( i=1; i <= ${#words[@]}; i++ )); do
    case "${words[$i]}" in
      --pipeline)
        pipeline_ref="${words[$((i+1))]}"
        break
        ;;
      --*) ;;
      *)
        # First non-flag after "run" is the positional pipeline arg
        if [[ $i -gt 1 && "${words[$((i-1))]}" != "--pipeline" && "${words[$i]}" != "run" ]]; then
          pipeline_ref="${words[$i]}"
          break
        fi
        ;;
    esac
  done

  [[ -z "$pipeline_ref" ]] && return

  # Resolve pipeline path
  local pipeline_path=""
  if [[ "$pipeline_ref" == *.yaml || "$pipeline_ref" == *.yml ]]; then
    pipeline_path="$pipeline_ref"
  elif [[ -f "${pipelines_dir}/${pipeline_ref}.yaml" ]]; then
    pipeline_path="${pipelines_dir}/${pipeline_ref}.yaml"
  fi

  [[ -z "$pipeline_path" || ! -f "$pipeline_path" ]] && return

  # Extract variable keys from the variables: section
  local -a var_keys
  var_keys=( $(sed -n '/^variables:/,/^[^ ]/{ /^  [a-z]/s/^  \([a-z][a-z0-9-]*\):.*/\1=/p }' "$pipeline_path") )

  [[ ${#var_keys[@]} -eq 0 ]] && return

  _describe 'variable' var_keys -S ''
}

_trayline_agent() {
  local -a agents
  agents=(
    'kiro:Run Kiro CLI agent'
    'claude:Run Claude Code agent'
  )

  case $CURRENT in
    2)
      _describe 'agent' agents
      ;;
    *)
      _arguments \
        '-p[Project directory]:directory:_directories' \
        '-m[Model to use]:model:' \
        '-i[Interactive mode]' \
        '-h[Show help]' \
        '*:prompt:'
      ;;
  esac
}

_trayline_sync() {
  local -a actions
  actions=(
    'push:Send local changes to remote (git or rsync)'
    'pull:Fetch remote changes to local (git or rsync)'
    'setup:Initialize bare + working repo on agent machine'
  )

  case $CURRENT in
    2)
      _describe 'action' actions
      ;;
    *)
      _arguments \
        '--rsync[Use rsync instead of git]' \
        '--full[(pull --rsync) Pull everything including .kiro/]' \
        '--specs-only[(push --rsync) Push only .kiro/ directory]' \
        '--agents-only[(pull --rsync) Pull only .agents/ directory]' \
        '--code-only[(pull --rsync) Pull only code]' \
        '--dry-run[Show what would happen without doing it]' \
        '(-v --verbose)'{-v,--verbose}'[Show detailed output]' \
        '(-h --help)'{-h,--help}'[Show help]'
      ;;
  esac
}

_trayline_run() {
  _arguments \
    '1:pipeline:_trayline_pipelines' \
    '--pipeline[Pipeline name or path (alternative to positional)]:pipeline:_trayline_pipelines' \
    '--dry-run[Print steps without executing]' \
    '--verbose[Stream output in real time]' \
    '--log-llm[Log LLM requests and responses to llm-debug.log]' \
    '--no-lifecycle[Skip lifecycle.yaml before/after steps]' \
    '--restart[Ignore checkpoint and start from the beginning]' \
    '*--var[Set variable key=value]:variable:_trayline_pipeline_vars'
}

_trayline() {
  local -a commands
  commands=(
    'agent:Run an AI agent in Docker sandbox'
    'sync:Sync project with remote server'
    'run:Run a pipeline (orchestrator)'
    'install:Re-run installation'
    'version:Print version info'
    'help:Show help'
  )

  if (( CURRENT == 2 )); then
    _describe 'command' commands
  else
    local cmd="${words[2]}"
    (( CURRENT-- ))
    shift words

    case "$cmd" in
      agent) _trayline_agent ;;
      sync)  _trayline_sync ;;
      run)   _trayline_run ;;
      *)     _message 'no more arguments' ;;
    esac
  fi
}

_trayline "$@"
