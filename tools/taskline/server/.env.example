# Server port (default: 9090)
APP_PORT=9090

# Address to bind to (default: 127.0.0.1 — loopback-only, unreachable from
# other hosts). Every submitted task runs as an unrestricted shell command, so
# binding to anything else (e.g. 0.0.0.0) REQUIRES APP_TOKEN to be set below —
# the server refuses to start otherwise.
BIND_ADDR=127.0.0.1

# Bearer token required on every request except GET /health, when set.
# Mandatory if BIND_ADDR is not loopback-only. Leave unset for a purely local
# deployment. Must match the CLI's TASKLINE_TOKEN.
APP_TOKEN=

# Directory for per-project state JSON files, one per project:
# <STATE_DIR>/taskline-<project>.json (default: ./state/)
STATE_DIR=./state/

# Directory for per-project log files, one per project: <LOG_DIR>/<project>.log
# (default: ./logs/)
LOG_DIR=./logs/

# Email address to notify when a task fails (leave unset to disable notifications)
NOTIFY_EMAIL=

# --- SMTP configuration (required for notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Defaults to SMTP_USER if not set
SMTP_FROM=
