{$RELAY_DOMAIN} {
    reverse_proxy {$WG_HOME_AGENT_IP}:{$UPSTREAM_PORT} {
        header_up Host {host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        transport http {
            dial_timeout 30s
            response_header_timeout 30s
        }
    }
}
