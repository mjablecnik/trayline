#!/usr/bin/env zsh
set -euo pipefail

TRAYLINE_HOME="${TRAYLINE_HOME:-${HOME}/.trayline}"
PIPELINES_DIR="${TRAYLINE_HOME}/pipelines"

usage() {
  cat <<EOF
trayline — unified CLI for AI agent pipelines

Usage:
  trayline <command> [options]

Commands:
  agent <kiro|claude> [opts] [prompt]   Run an AI agent in Docker sandbox
  sync <push|pull> [--verbose]          Sync project with remote server
  run <pipeline> [opts]                 Run a single pipeline (orchestrator)
  flow <pipeline> [--then <pipeline>]   Run multiple pipelines sequentially
  schedule <pipeline|sub-action> [opts] Schedule pipelines on the remote server
  install                               Re-run installation
  version                               Print version info
  help                                  Show this help

Pipeline resolution (run/flow commands):
  ./path/to/file.yaml                   Use local file directly
  my-pipeline                           Resolve from ${PIPELINES_DIR}/my-pipeline.yaml

Schedule sub-actions:
  schedule <pipeline> [--var k=v]       Schedule a pipeline on the remote server
  schedule list                         List scheduled workflows
  schedule show <id>                    Show workflow detail
  schedule cancel <id>                  Cancel a workflow
  schedule logs [id]                    Stream workflow logs

Examples:
  trayline agent claude "Fix the bug"
  trayline agent kiro -i
  trayline sync push --verbose
  trayline run processes/8-code-review --var path=. --verbose
  trayline run ./local.yaml --dry-run
  trayline flow processes/8-code-review --var path=. --then processes/9-improvements --var path=.
  trayline schedule workflows/feature-impl --var specs-name=010
  trayline schedule list
  trayline schedule logs
EOF
  exit 0
}

[[ $# -eq 0 ]] && usage

# Resolve a pipeline reference to a full path
resolve_pipeline() {
  local ref="$1"
  # If it's already a path (contains / or ends with .yaml/.yml), use as-is
  if [[ "$ref" == *.yaml || "$ref" == *.yml ]]; then
    echo "$ref"
    return
  fi
  # Try to resolve from pipelines directory (supports subdirectories like processes/4-create-code)
  local resolved="${PIPELINES_DIR}/${ref}.yaml"
  if [[ -f "$resolved" ]]; then
    echo "$resolved"
    return
  fi
  # Try without subdirectory (flat lookup)
  resolved="${PIPELINES_DIR}/${ref}.yaml"
  if [[ -f "$resolved" ]]; then
    echo "$resolved"
    return
  fi
  echo "error: pipeline '${ref}' not found in ${PIPELINES_DIR}/" >&2
  echo "Available pipelines:" >&2
  find "${PIPELINES_DIR}" -name "*.yaml" -not -name "lifecycle.yaml" | sed "s|${PIPELINES_DIR}/||;s|\.yaml$||" | sort | sed 's/^/  /' >&2
  exit 1
}

COMMAND="$1"; shift

case "$COMMAND" in
  agent)
    exec "${TRAYLINE_HOME}/trayline-agent" "$@"
    ;;
  sync)
    exec "${TRAYLINE_HOME}/sync.sh" "$@"
    ;;
  schedule)
    exec "${TRAYLINE_HOME}/trayline-client" schedule "$@"
    ;;
  run)
    # Resolve pipeline names to paths
    FLAGS=()
    POSITIONAL=""
    PIPELINE_RESOLVED=false
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --var)
          # --var takes a value argument
          FLAGS+=("$1" "$2")
          shift 2
          ;;
        --*)
          FLAGS+=("$1")
          shift
          ;;
        *)
          # First non-flag argument is treated as pipeline (positional)
          if ! $PIPELINE_RESOLVED; then
            POSITIONAL=$(resolve_pipeline "$1")
            PIPELINE_RESOLVED=true
          else
            FLAGS+=("$1")
          fi
          shift
          ;;
      esac
    done
    exec "${TRAYLINE_HOME}/trayline-run" "${FLAGS[@]}" "$POSITIONAL"
    ;;
  flow)
    # Resolve pipeline names in each --then segment.
    # IMPORTANT: Go's flag package stops parsing flags after the first positional
    # argument, so we must emit each segment's flags BEFORE its pipeline path.
    ARGS=()
    SEGMENT_FLAGS=()
    SEGMENT_PIPELINE=""
    flush_segment() {
      if [[ -n "$SEGMENT_PIPELINE" ]]; then
        ARGS+=("${SEGMENT_FLAGS[@]}" "$SEGMENT_PIPELINE")
      fi
      SEGMENT_FLAGS=()
      SEGMENT_PIPELINE=""
    }
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --then)
          flush_segment
          ARGS+=("$1")
          shift
          ;;
        --var)
          SEGMENT_FLAGS+=("$1" "$2")
          shift 2
          ;;
        --*)
          SEGMENT_FLAGS+=("$1")
          shift
          ;;
        *)
          # Non-flag positional argument = pipeline name, resolve it
          SEGMENT_PIPELINE=$(resolve_pipeline "$1")
          shift
          ;;
      esac
    done
    flush_segment
    exec "${TRAYLINE_HOME}/trayline-run" flow "${ARGS[@]}"
    ;;
  install)
    exec "${TRAYLINE_HOME}/../bin/trayline-install"
    ;;
  version)
    echo "trayline wrapper v2.4.0"
    "${TRAYLINE_HOME}/trayline-run" --version 2>/dev/null || true
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "error: unknown command '${COMMAND}'" >&2
    echo "Run 'trayline help' for usage." >&2
    exit 1
    ;;
esac
