#!/usr/bin/env bash
set -euo pipefail

TRAYLINE_HOME="${TRAYLINE_HOME:-${HOME}/.trayline}"
PIPELINES_DIR="${TRAYLINE_HOME}/pipelines"

usage() {
  cat <<EOF
trayline — unified CLI for AI agent pipelines

Usage:
  trayline <command> [options]

Commands:
  agent <kiro|claude|cline> [opts] [prompt]   Run an AI agent in Docker sandbox
  sync <push|pull> [--verbose]          Sync project with remote server
  run <pipeline> [opts]                 Run a single pipeline (orchestrator)
  flow <pipeline> [--then <pipeline>]   Run multiple pipelines sequentially
  schedule <pipeline|sub-action> [opts] Schedule pipelines via the local taskline queue
  install                               Re-run installation
  version                               Print version info
  help                                  Show this help

Pipeline resolution (run/flow commands):
  ./path/to/file.yaml                   Use local file directly
  my-pipeline                           Resolve from ${PIPELINES_DIR}/my-pipeline.yaml

Schedule sub-actions (delegates to the local taskline CLI, project-scoped
by the current directory's basename, override with --project):
  schedule <pipeline> [--var k=v]       Schedule a pipeline
  schedule list                         List queued/running tasks
  schedule status                       Show queue status
  schedule logs                         Stream logs in real time
  schedule retry                        Retry the failed task
  schedule stop                         Stop the running task
  schedule cancel <id>                  Cancel a task (stop if running, else delete)
  schedule delete <id>                  Delete a queued task

Examples:
  trayline agent claude "Fix the bug"
  trayline agent kiro -i
  trayline agent cline -t high "Refactor auth"
  trayline agent claude remote                    # remote-control mode
  trayline agent claude remote -p ~/project -n "Proj"
  trayline sync push --verbose
  trayline run processes/8-code-review --var path=. --verbose
  trayline run ./local.yaml --dry-run
  trayline flow processes/8-code-review --var path=. --then processes/9-improvements --var path=.
  trayline schedule workflows/feature-impl --var specs-name=010
  trayline schedule list
  trayline schedule logs
EOF
  exit 0
}

[[ $# -eq 0 ]] && usage

# Resolve a pipeline reference to a full path
resolve_pipeline() {
  local ref="$1"
  # If it's already a path (contains / or ends with .yaml/.yml), use as-is
  if [[ "$ref" == *.yaml || "$ref" == *.yml ]]; then
    echo "$ref"
    return
  fi
  # Try to resolve from pipelines directory (supports subdirectories like processes/4-create-code)
  local resolved="${PIPELINES_DIR}/${ref}.yaml"
  if [[ -f "$resolved" ]]; then
    echo "$resolved"
    return
  fi
  # Try without subdirectory (flat lookup)
  resolved="${PIPELINES_DIR}/${ref}.yaml"
  if [[ -f "$resolved" ]]; then
    echo "$resolved"
    return
  fi
  echo "error: pipeline '${ref}' not found in ${PIPELINES_DIR}/" >&2
  echo "Available pipelines:" >&2
  find "${PIPELINES_DIR}" -name "*.yaml" -not -name "lifecycle.yaml" | sed "s|${PIPELINES_DIR}/||;s|\.yaml$||" | sort | sed 's/^/  /' >&2
  exit 1
}

COMMAND="$1"; shift

case "$COMMAND" in
  agent)
    exec "${TRAYLINE_HOME}/trayline-agent" "$@"
    ;;
  sync)
    exec "${TRAYLINE_HOME}/sync.sh" "$@"
    ;;
  schedule)
    # Redirect to the local taskline CLI, project-scoped by the current
    # directory's basename (FR-6.2), overridable via --project.
    PROJECT="$(basename "$(pwd)")"
    ARGS=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --project)
          PROJECT="$2"
          shift 2
          ;;
        --project=*)
          PROJECT="${1#--project=}"
          shift
          ;;
        *)
          ARGS+=("$1")
          shift
          ;;
      esac
    done
    set -- "${ARGS[@]}"

    # Normalize: lowercase, replace spaces/invalid chars with hyphens, trim to 64 chars
    PROJECT="$(echo "$PROJECT" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | sed 's/[^a-z0-9_-]/-/g' | cut -c1-64)"

    if [[ $# -eq 0 ]]; then
      echo "error: schedule requires a sub-action or pipeline name" >&2
      exit 1
    fi

    SUB="$1"; shift

    case "$SUB" in
      list)
        exec taskline list --project "$PROJECT"
        ;;
      status)
        exec taskline status --project "$PROJECT"
        ;;
      logs)
        exec taskline logs --project "$PROJECT" --follow "$@"
        ;;
      retry)
        exec taskline retry --project "$PROJECT"
        ;;
      stop)
        exec taskline stop --project "$PROJECT"
        ;;
      delete)
        [[ $# -ge 1 ]] || { echo "error: schedule delete requires an id argument" >&2; exit 1; }
        exec taskline delete "$1" --project "$PROJECT"
        ;;
      cancel)
        # Cancel stops the task if it's the one currently running, otherwise
        # it deletes the (pending) task (FR-6.4).
        [[ $# -ge 1 ]] || { echo "error: schedule cancel requires an id argument" >&2; exit 1; }
        ID="$1"
        # TODO: use machine-readable output (e.g. --json) when available
        CURRENT_ID=$(taskline status --project "$PROJECT" 2>/dev/null | sed -n 's/^Current task: [^(]*(\([^)]*\)).*/\1/p')
        if [[ -n "$CURRENT_ID" && "$CURRENT_ID" == "$ID" ]]; then
          exec taskline stop --project "$PROJECT"
        else
          exec taskline delete "$ID" --project "$PROJECT"
        fi
        ;;
      *)
        # Default: schedule a pipeline (FR-6.1, FR-6.9, FR-6.10). Resolve the
        # pipeline name to a full path, then build a single "trayline run ..."
        # command string that taskline executes via sh -c, shell-quoting each
        # part so --var values with spaces survive the round trip.
        PIPELINE=$(resolve_pipeline "$SUB")
        CMD_PARTS=(trayline run "$PIPELINE")
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --var)
              CMD_PARTS+=(--var "$2")
              shift 2
              ;;
            *)
              echo "error: unknown schedule option '$1'" >&2
              exit 1
              ;;
          esac
        done
        CMD=""
        for part in "${CMD_PARTS[@]}"; do
          CMD="${CMD}$(printf '%q' "$part") "
        done
        exec taskline add "${CMD% }" --project "$PROJECT"
        ;;
    esac
    ;;
  run)
    # Resolve pipeline names to paths
    FLAGS=()
    POSITIONAL=""
    PIPELINE_RESOLVED=false
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --var)
          # --var takes a value argument
          FLAGS+=("$1" "$2")
          shift 2
          ;;
        --*)
          FLAGS+=("$1")
          shift
          ;;
        *)
          # First non-flag argument is treated as pipeline (positional)
          if ! $PIPELINE_RESOLVED; then
            POSITIONAL=$(resolve_pipeline "$1")
            PIPELINE_RESOLVED=true
          else
            FLAGS+=("$1")
          fi
          shift
          ;;
      esac
    done
    exec "${TRAYLINE_HOME}/trayline-run" "${FLAGS[@]}" "$POSITIONAL"
    ;;
  flow)
    # Resolve pipeline names in each --then segment.
    # IMPORTANT: Go's flag package stops parsing flags after the first positional
    # argument, so we must emit each segment's flags BEFORE its pipeline path.
    ARGS=()
    SEGMENT_FLAGS=()
    SEGMENT_PIPELINE=""
    flush_segment() {
      if [[ -n "$SEGMENT_PIPELINE" ]]; then
        ARGS+=("${SEGMENT_FLAGS[@]}" "$SEGMENT_PIPELINE")
      fi
      SEGMENT_FLAGS=()
      SEGMENT_PIPELINE=""
    }
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --then)
          flush_segment
          ARGS+=("$1")
          shift
          ;;
        --var)
          SEGMENT_FLAGS+=("$1" "$2")
          shift 2
          ;;
        --*)
          SEGMENT_FLAGS+=("$1")
          shift
          ;;
        *)
          # Non-flag positional argument = pipeline name, resolve it
          SEGMENT_PIPELINE=$(resolve_pipeline "$1")
          shift
          ;;
      esac
    done
    flush_segment
    exec "${TRAYLINE_HOME}/trayline-run" flow "${ARGS[@]}"
    ;;
  install)
    exec "${TRAYLINE_HOME}/../bin/trayline-install"
    ;;
  version)
    echo "trayline wrapper v2.4.0"
    "${TRAYLINE_HOME}/trayline-run" --version 2>/dev/null || true
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    echo "error: unknown command '${COMMAND}'" >&2
    echo "Run 'trayline help' for usage." >&2
    exit 1
    ;;
esac
