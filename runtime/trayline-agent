#!/usr/bin/env bash
set -euo pipefail

IMAGE_NAME="trayline-sandbox"
PROXY_NAME="trayline-proxy"
NETWORK_NAME="trayline-net"
usage() {
  cat <<EOF
Usage: trayline-agent <kiro|claude|cline> [remote] [-p project-dir] [-m model] [-t thinking] [-i] [prompt]

Run an AI coding agent in a sandboxed Docker container with access to host Docker.

Commands:
  kiro     Run Kiro CLI agent
  claude   Run Claude Code agent
  cline    Run Cline CLI agent

Modes:
  remote   Start Claude in remote-control mode (claude only, accessible from claude.ai/code)

Options:
  -p DIR       Path to project directory (default: current directory)
  -m MODEL     Model to use (e.g. claude-sonnet-4-20250514, default: agent's default)
  -t LEVEL     Thinking/effort level (low, medium, high, xhigh, max)
  -i           Start in interactive mode (no prompt required)
  -n NAME      Session name for remote-control mode (default: directory basename)
  -h           Show this help

Examples:
  trayline-agent kiro "Show me running containers"       # one-shot
  trayline-agent kiro -p ~/my-project "Add /health"      # one-shot with project
  trayline-agent claude -m claude-sonnet-4-20250514 -p ~/project "Fix tests"
  trayline-agent cline -t high "Refactor auth module"    # cline with high thinking
  trayline-agent kiro -i                                  # interactive
  trayline-agent claude -p ~/my-project -i                # claude, interactive
  trayline-agent cline -i                                 # cline, interactive
  trayline-agent claude remote                            # remote-control (foreground)
  trayline-agent claude remote -p ~/my-project -n "My Proj"  # remote-control with name
EOF
  exit 0
}

[[ $# -eq 0 ]] && usage

AGENT="${1}"; shift
if [[ "$AGENT" == "-h" || "$AGENT" == "--help" ]]; then usage; fi
if [[ "$AGENT" != "kiro" && "$AGENT" != "claude" && "$AGENT" != "cline" ]]; then
  echo "Error: first argument must be 'kiro', 'claude', or 'cline'" >&2; exit 1
fi

INTERACTIVE=false
REMOTE_CONTROL=false
PROJECT_DIR="$(pwd)"
MODEL=""
THINKING=""
SESSION_NAME=""

# Check if the next argument is "remote" (positional mode selector)
if [[ "${1:-}" == "remote" ]]; then
  REMOTE_CONTROL=true
  shift
fi

while [[ "${1:-}" == -* ]]; do
  case "$1" in
    -p) PROJECT_DIR="$(cd "$2" && pwd)"; shift 2 ;;
    -m) MODEL="$2"; shift 2 ;;
    -t) THINKING="$2"; shift 2 ;;
    -i) INTERACTIVE=true; shift ;;
    -n) SESSION_NAME="$2"; shift 2 ;;
    -h|--help) usage ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

PROMPT="$*"

if $REMOTE_CONTROL; then
  if [[ "$AGENT" != "claude" ]]; then
    echo "Error: remote-control mode is only supported for claude agent" >&2
    exit 1
  fi
elif ! $INTERACTIVE && [[ -z "$PROMPT" ]]; then
  usage
fi

# Check image exists (must be built via install.sh)
if ! docker image inspect "$IMAGE_NAME" &>/dev/null; then
  echo "Error: Docker image '$IMAGE_NAME' not found. Run 'trayline install' first." >&2
  exit 1
fi

# Create network if needed
docker network inspect "$NETWORK_NAME" &>/dev/null || \
  docker network create "$NETWORK_NAME"

# Start docker socket proxy if not running
if ! docker inspect "$PROXY_NAME" &>/dev/null; then
  docker run -d --name "$PROXY_NAME" \
    --network "$NETWORK_NAME" \
    --restart unless-stopped \
    -v /var/run/docker.sock:/var/run/docker.sock:ro \
    -e CONTAINERS=1 \
    -e IMAGES=1 \
    -e NETWORKS=1 \
    -e LOGS=1 \
    -e BUILD=1 \
    -e POST=1 \
    -e EXEC=1 \
    -e ALLOW_START=1 \
    -e ALLOW_STOP=1 \
    -e ALLOW_RESTARTS=1 \
    -e VOLUMES=0 \
    -e NODES=0 \
    -e SERVICES=0 \
    -e SWARM=0 \
    -e SECRETS=0 \
    -e CONFIGS=0 \
    -e AUTH=0 \
    tecnativa/docker-socket-proxy
fi

# Build agent-specific command and volumes
VOLUMES=(
  -v "$PROJECT_DIR":/workspace
)

AGENT_HOME="/home/agent"

if [[ "$AGENT" == "kiro" ]]; then
  VOLUMES+=(
    -v "${HOME}/.kiro":"${AGENT_HOME}/.kiro"
    -v "${HOME}/.local/share/kiro-cli":"${AGENT_HOME}/.local/share/kiro-cli"
  )
  CMD=(kiro-cli chat --trust-all-tools)
  if [[ -n "$MODEL" ]]; then
    CMD+=(--model "$MODEL")
  fi
  if [[ -n "$THINKING" ]]; then
    CMD+=(--effort "$THINKING")
  fi
  if ! $INTERACTIVE; then
    CMD+=(--no-interactive "$PROMPT")
  fi
elif [[ "$AGENT" == "claude" ]]; then
  VOLUMES+=(
    -v "${HOME}/.claude":"${AGENT_HOME}/.claude"
    -v "${HOME}/.claude.json":"${AGENT_HOME}/.claude.json"
  )
  if $REMOTE_CONTROL; then
    # Remote-control server mode — Claude registers with Anthropic API and
    # waits for connections from claude.ai/code or the Claude mobile app.
    CMD=(claude remote-control --dangerously-skip-permissions)
    if [[ -n "$SESSION_NAME" ]]; then
      CMD+=(--name "$SESSION_NAME")
    else
      CMD+=(--name "trayline: $(basename "$PROJECT_DIR")")
    fi
    if [[ -n "$MODEL" ]]; then
      CMD+=(--model "$MODEL")
    fi
  else
    CMD=(claude)
    if [[ -n "$MODEL" ]]; then
      CMD+=(--model "$MODEL")
    fi
    if [[ -n "$THINKING" ]]; then
      CMD+=(--effort "$THINKING")
    fi
    if $INTERACTIVE; then
      CMD+=(--dangerously-skip-permissions)
    else
      CMD+=(--dangerously-skip-permissions -p "$PROMPT")
    fi
  fi
elif [[ "$AGENT" == "cline" ]]; then
  VOLUMES+=(
    -v "${HOME}/.cline":"${AGENT_HOME}/.cline"
  )
  CMD=(cline)
  if [[ -n "$MODEL" ]]; then
    CMD+=(-m "$MODEL")
  fi
  if [[ -n "$THINKING" ]]; then
    CMD+=(--thinking "$THINKING")
  fi
  if $INTERACTIVE; then
    CMD+=(-i --auto-approve true)
  else
    CMD+=(--yolo "$PROMPT")
  fi
fi

# Run sandbox connected to proxy
# Use -it only when stdin is a TTY (interactive terminal);
# pipelines and other non-interactive callers get no TTY flags.
DOCKER_FLAGS=(--rm)
if [ -t 0 ]; then
  DOCKER_FLAGS+=(-it)
fi

docker run "${DOCKER_FLAGS[@]}" \
  --network "$NETWORK_NAME" \
  -e DOCKER_HOST="tcp://${PROXY_NAME}:2375" \
  "${VOLUMES[@]}" \
  "$IMAGE_NAME" \
  "${CMD[@]}"
